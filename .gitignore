# Large third-party binaries (download separately — see README).
# ffmpeg/ffprobe нужны ОБЕИМ сторонам и ищутся рядом со СВОИМ скриптом:
# yt-dlp/ffmpeg.exe и yt-dlp/ffprobe.exe (100+ МБ) без этих строк уходили
# в `git add -A` — хук блокирует по содержимому, а не по расширению.
ffmpeg/ffmpeg.exe
ffmpeg/ffprobe.exe
yt-dlp/ffmpeg.exe
yt-dlp/ffprobe.exe
yt-dlp/yt-dlp.exe
yt-dlp/deno.exe
yt-dlp/vot-cli-live.exe

# Local config with secrets (proxy credentials, cookies path, etc).
# Template committed as yt-dlp/config.ini.example
yt-dlp/config.ini

# Same scheme for ffmpeg: the [remote] endpoint and API key of the transcode
# service are written here in plain text. Template: ffmpeg/config.ini.example
ffmpeg/config.ini

# Local channel list — may reveal real channels/interests/work sources.
# Template committed as yt-dlp/channels.txt.example
yt-dlp/channels.txt

# ps2exe build artifacts
_build_tmp.ps1

# Claude Code / agent-side files
.claude/
AGENTS.md
CLAUDE.md
FINDINGS.md

# local-only secret denylist for pre-commit hook (never commit)
.sanitize-patterns

# Agent-side backlog files (private to maintainer, never published)
FINDINGS-archive.md
IDEAS.md
IDEAS-archive.md
