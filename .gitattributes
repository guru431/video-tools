# Shell scripts must be LF: CRLF breaks shebangs and `$'\r'` errors under WSL/Linux/CI bash
*.sh text eol=lf

# Keep the git hook as LF so its shebang works after a fresh clone on Windows
.githooks/pre-commit text eol=lf

# Mock binaries have no extension; force LF so their shebangs work on Linux/WSL/CI
tests/mocks/* text eol=lf

# Фикстуры сверяются с выводом БАЙТ В БАЙТ (ожидаемые расшифровки ASR — LF):
# без -text core.autocrlf=true на свежем Windows-клоне превратил бы их в CRLF,
# и сравнение упало бы при верном коде.
tests/fixtures/** -text

# Sidecar-суммы EXE сверяют `sha256sum -c`, а для него CR в конце строки — часть имени
# файла: «No such file or directory» на верной сумме. Write-ExeChecksum пишет LF, но без
# этого правила core.autocrlf=true возвращал CRLF при checkout, и свежий Windows-клон
# не мог сверить EXE с его собственным sidecar.
*.sha256 text eol=lf

# CMD batch files обязаны быть CRLF, и это правило стоит ПОСЛЕДНИМ — оно должно
# перекрывать `tests/mocks/*` выше (тот glob написан для extension-less bash-моков,
# но захватывал и tests/mocks/ffmpeg.cmd).
# С LF-концами cmd.exe разбирает многострочные `( )`-блоки и goto-циклы неверно:
# строки склеиваются, ссылки %1 раскрываются один раз, `shift` перестаёт двигать
# аргументы — подпрограмма :find_out мока уходила в бесконечный цикл на 100% CPU
# без дочерних процессов, и полный прогон вставал на test_16/test_17 намертво.
*.cmd text eol=crlf
