[proxy]
# Оставить пустым если прокси не нужен
# Формат: схема://[user:pass@]host[:port]. Схему указывать ОБЯЗАТЕЛЬНО:
# http, https, socks4, socks4a, socks5, socks5h.
# Пример: https://username:password@proxy.example.com:443
# Поддерживается подстановка из окружения: url = ${PROXY_URL}
# (несколько вхождений ок; не заданная переменная -> пустая строка + WARN)
url =

[cookies]
# Метод: none, file, browser
method = none
# Путь к файлу cookies (при method=file)
file = youtube_cookies.txt
# Браузер для извлечения cookies (при method=browser): chrome, firefox, edge
browser = chrome

[output]
# Базовая папка для загрузок
base_dir = _video_
# Шаблон имени файла для одиночных видео
template = %(uploader)s/%(upload_date)s - %(title).100U.%(ext)s
# Шаблон для плейлистов
playlist_template = %(uploader)s/%(playlist)s/%(playlist_index)03d - %(title).100U.%(ext)s
# Лимиты (.100U и т.п.) — ВЕРХНЯЯ граница, а не гарантия: программа сама ужимает их
# под лимит Windows в 259 символов на путь, считая бюджет от длины base_dir, и сама
# проставляет лимиты полям, у которых их нет (иначе длина %(title)s/%(playlist)s
# непредсказуема и yt-dlp падает на .part-файле с «No such file or directory»).
# Задавать лимиты здесь имеет смысл только чтобы сделать имена ЕЩЁ короче.

[download]
# Качество по умолчанию: 360, 480, 720, 1080, 1440, 2160, audio
# audio — скачать только аудиодорожку (формат задаётся ключом audio_format ниже).
default_quality = 720
# Пресет формата: auto, avc1_best, avc1_https, avc1_m3u8,
#   avc1_https_60fps, avc1_m3u8_60fps, avc1_https_60fps_hdr, old_combo
# auto: для YouTube = avc1_best, для VK/RuTube/прочих = простой best (один поток, быстро)
format_preset = auto
# Продолжать при ошибках в плейлисте
continue_on_error = true
# Пропускать уже скачанные видео (download archive)
use_archive = true
# Путь относителен base_dir выше; абсолютный путь берётся как есть.
archive_file = download_archive.txt
# Формат аудио при выборе «только аудио»: best (как отдаёт сервер), mp3, m4a,
# opus, flac, wav. При best дорожка извлекается без перекодирования.
audio_format = best
# SponsorBlock: off (выкл), mark (отметить главами), remove (вырезать сегменты)
sponsorblock = off
# Ссылка с &list=… : auto — как решит yt-dlp (плейлист), single — только указанное
# видео (--no-playlist), full — всегда весь плейлист. single спасает от ссылок
# вида watch?v=X&list=RD… (бесконечный авто-микс YouTube).
playlist = auto

[network]
# Профиль устойчивости загрузки. Влияет на число параллельных фрагментов,
# количество повторов, паузу между повторами и socket timeout:
#   careful — медленный/нестабильный канал: 1 фрагмент, 20 попыток, пауза 5с, таймаут 60с
#   normal  — по умолчанию: 4 фрагмента, 10 попыток, без паузы, таймаут 30с
#   fast    — быстрый стабильный канал: 8 фрагментов, 5 попыток, таймаут 15с
# CLI: --speed-profile careful|normal|fast
speed_profile = normal
# Потолок скорости загрузки. Пусто = без ограничения. Примеры: 2M, 500K, 1.5M
# CLI: --limit-rate 2M
limit_rate =

[subtitles]
# Язык субтитров для режима «только субтитры» и для download_with_video.
# На пункты меню CMD-загрузчика «Субтитры (RU)/(EN)» НЕ влияет: тот интерактивный
# CLI config.ini не читает вовсе (санкционированное исключение, см. CLAUDE.md).
lang = ru
# Формат субтитров. У YouTube нативно доступен только vtt: srt пришлось бы
# конвертировать (--convert-subs), а этого флага скрипт не передаёт — значение
# srt для YouTube просто не сработает. Ключ действует на режим «только субтитры»
# и НЕ действует на download_with_video ниже (там формат выбирает yt-dlp).
format = vtt
# Скачивать субтитры вместе с видео: off, sidecar (отдельный файл), embed (встроить в контейнер)
download_with_video = off

# ВСЯ СЕКЦИЯ [batch] — только для .sh (флаг --batch). CMD и GUI режима batch не
# имеют вовсе, и эти ключи там не читаются.
[batch]
# Период для batch-загрузки: now-1month, now-3months, now-6months, now-1year
date_range = now-6months
# Задержки между запросами (секунды) — защита от блокировки
sleep_requests = 1.8
sleep_interval = 8
max_sleep_interval = 22
sleep_subtitles = 4

[trim]
# Скачать фрагмент ролика. Формат: ЧЧ:ММ:СС, М:СС, или секунды.
# +/- перед значением — включено/выключено. Комбинации:
#   только start  = с TIME до конца ролика  (вырезать "хвост")
#   только end    = с начала до TIME        (вырезать "начало")
#   start + end   = фрагмент TIME1..TIME2   (вырезать "середину")
#   обе выкл      = весь ролик
start = -00:00:00
end   = -00:01:00
# Точная обрезка по границам (перекодирует только концы фрагмента, медленнее).
# Без этого yt-dlp режет по ближайшему ключевому кадру (быстро, но ±1-10 сек).
force_keyframes = false

[translation]
# Включить AI-перевод аудиодорожки: true/false
enabled = false
# Язык перевода: ru, en, kk
target_lang = ru
# Стиль голоса: live (живые голоса) / tts (синтез)
voice_style = live
# Режим: dual_track (2 дорожки) / replace (заменить оригинал) / mix (смешать)
mode = mix
# Громкость оригинала при mode=mix (0.0-2.0)
original_volume = 0.3
# Громкость перевода при mode=mix (0.0-2.0)
translation_volume = 1.0
# Обе громкости: неотрицательное число с ТОЧКОЙ как разделителем. Запятая («0,3»)
# рвёт filter_complex ffmpeg — проверяется до запуска и отклоняется с сообщением.
# Язык оригинала. Для mp4 код приводится к трёхбуквенному (ISO 639-2): ru → rus.
original_lang = en
# Потолок времени на один вызов vot-cli-live, секунды (0 = без ограничения).
# Без него зависший перевод держал прогон бессрочно; двухчасовому ролику
# 900 с может не хватить — тогда увеличьте.
timeout_sec = 900
